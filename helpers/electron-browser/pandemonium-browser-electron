#!/bin/sh
# Starts the Electron browser helper; the window finds it through PANDEMONIUM_BROWSER_HELPER.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "$(uname -s)" in
    Darwin) exec "$here/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" "$here/main.js" "$@" ;;
    *) exec "$here/node_modules/electron/dist/electron" --ozone-platform-hint=auto "$here/main.js" "$@" ;;
esac
